# Dependencies
node_modules/
.pnp/
.pnp.js

# Environment
.env
.env.*
!.env.example

# Build output
dist/
build/
client/dist/
*.tsbuildinfo

# Test / coverage artifacts
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/
.vitest/

# Uploaded user content (never commit). Ignore the *contents* of the upload
# directories, never the directories themselves: excluding a directory makes every
# `!` negation underneath it inert, which is why `server/uploads/.gitkeep` could
# never be committed while `uploads/` also excluded `server/uploads/`.
uploads/*
server/uploads/*
!server/uploads/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Runtime
*.pid
*.seed
.eslintcache
.cache/

# Generated audit output (rewritten by the audit harnesses on every run; never read as input)

audit/api-audit-results.json

audit/runtime-audit-results.json

audit/browser-audit-results.json

audit/dom-budget.json

audit/responsive-audit.json

audit/lifecycle-probe.json

audit/responsive/

# Screenshots the browser audit rewrites each run. Regenerated output, never
# published; the documented copies in docs/assets/screenshots/ are tracked.

audit/screenshots/

# Playwright authentication state (live session cookie), regenerated by e2e/auth.setup.js

e2e/.auth/
