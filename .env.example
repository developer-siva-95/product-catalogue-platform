# ---------------------------------------------------------------------------
# Server configuration — copy this file to server/.env
#
#   Linux / macOS :  cp .env.example server/.env
#   Windows       :  Copy-Item .env.example server\.env        (PowerShell)
#                    or run `npm run setup`, which creates server/.env for you
#                    and fills in a fresh JWT_SECRET.
#
# The API reads server/.env only. Variables exported in your shell win over the
# file (dotenv does not override an existing environment variable), which is how
# the npm scripts below force a provider without editing anything.
# ---------------------------------------------------------------------------
# HTTP port the API listens on
PORT=5000

# ---------------------------------------------------------------------------
# Database provider (dual-database deployment)
# ---------------------------------------------------------------------------
# Which storage backend the repository layer binds to. Both are first-class and
# fully supported; switching is configuration only, never a code change.
#
# DEFAULT IS MYSQL. If this line is missing entirely, the application selects
# Oracle MySQL 8.0 and logs `provider: mysql, source: default`. MongoDB is still
# fully supported, but it must be selected explicitly.
#   mysql   -> requires MYSQL_USER + MYSQL_DATABASE (and MYSQL_PASSWORD in prod)
#   mongodb -> requires MONGO_URI
#
# Values are case-insensitive and whitespace is trimmed (`MySQL` == `mysql`).
# An unsupported value is FATAL at startup; it never falls back to the other
# provider. The resolved provider and its source are logged at boot.
#
#   npm run dev            # MySQL (this value / the default)
#   npm run dev:mysql      # force MySQL      (PowerShell, cmd, bash — identical)
#   npm run dev:mongodb    # force MongoDB
#   npm run start:mysql    # production-style start, MySQL
#   npm run start:mongodb  # production-style start, MongoDB
#
# The provider switches above go through server/scripts/with-env.mjs, a Node
# launcher, so they work in Windows PowerShell without `VAR=value` syntax.
#
# Test suites do NOT rely on this default: `npm run test` (server) pins
# DATABASE_PROVIDER=mongodb, `npm run test:mysql` pins mysql, and the E2E / audit
# harnesses pass the provider they need explicitly.
DATABASE_PROVIDER=mysql

# MongoDB connection string (reference implementation).
#   standalone :  mongodb://127.0.0.1:27017/catalogue
#   replica set:  mongodb://127.0.0.1:27017/catalogue?replicaSet=rs0
# A replica set is required for multi-document transactions; the capability probe
# reports `transactions: false` on a standalone mongod (see REQUIRE_TRANSACTIONS).
MONGO_URI=mongodb://127.0.0.1:27017/catalogue

# Refuse to boot when the provider cannot run multi-document transactions.
# The catalogue's inventory path does not require them (guarded single-document
# updates + optimistic concurrency), so this defaults to false. Set it to true to
# fail fast instead of running on a topology that cannot transact.
REQUIRE_TRANSACTIONS=false

# ---------------------------------------------------------------------------
# MySQL provider (ignored unless DATABASE_PROVIDER=mysql)
# ---------------------------------------------------------------------------
# storefront_app is the least-privilege runtime user (DML only). Schema changes
# and the data migration use storefront_migrator instead — pass it per command:
#   PowerShell:  $env:MYSQL_USER='storefront_migrator'; npm run db:migrate
#   bash       :  MYSQL_USER=storefront_migrator npm run db:migrate
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=storefront_app
MYSQL_PASSWORD=
MYSQL_DATABASE=storefront
MYSQL_CONNECTION_LIMIT=10
MYSQL_QUERY_TIMEOUT_MS=30000
MYSQL_SSL=false

# Runtime environment: development | test | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# JWT signing secret.
#   - MUST be at least 32 characters, and at least 48 in production.
#   - MUST NOT be a well-known placeholder value (e.g. "secret", "changeme").
#   - Verified at startup: the process refuses to boot if it is too weak.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# JWT lifetime (vercel/ms style duration string, e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=1h

# ---------------------------------------------------------------------------
# CORS / cookies
# ---------------------------------------------------------------------------
# Exact origin of the React app (credentials: true requires an explicit origin)
FRONTEND_URL=http://localhost:5173

# Set to "true" to mark cookies as Secure (REQUIRED in production, ignored in dev)
COOKIE_SECURE=false

# SameSite policy for the auth/CSRF cookies.
#   lax    -> SPA and API on the same site (default; localhost:5173 -> localhost:5000 is same-site)
#   strict -> strongest, but breaks inbound links into the app
#   none   -> REQUIRES COOKIE_SECURE=true; only when SPA and API are on different sites
COOKIE_SAME_SITE=lax

# Lifetime of a CSRF token in milliseconds (aligned with a typical browser session)
CSRF_TOKEN_TTL_MS=7200000

# Public base path where uploaded product images are served from
PUBLIC_UPLOAD_PATH=/uploads

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# Max upload size in bytes (default 5 MiB)
MAX_UPLOAD_BYTES=5242880

# Comma-separated absolute path to store uploads (defaults to <server>/uploads)
UPLOAD_DIR=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------------------
# MySQL migrations (tooling only — never needed by the API at runtime)
# ---------------------------------------------------------------------------
# Apply the schema:   npm run db:migrate:mysql      (add :dry-run to preview)
# Show status:        npm run db:status:mysql
# Roll back:          npm run db:down:mysql         (DESTRUCTIVE — see below)
#
# A rollback is refused unless ALLOW_DESTRUCTIVE_MIGRATIONS=true AND the target
# database ends with "_test" or is listed in MYSQL_ALLOWED_DESTRUCTIVE_DATABASES.
ALLOW_DESTRUCTIVE_MIGRATIONS=false
MYSQL_ALLOWED_DESTRUCTIVE_DATABASES=

# ---------------------------------------------------------------------------
# MySQL test suite (npm run test:mysql)
# ---------------------------------------------------------------------------
# The MySQL suites skip when these are absent, so `npm run verify` needs no MySQL
# server. MYSQL_REQUIRE=1 turns "no server" into a failure (CI posture).
# MYSQL_TEST_HOST=127.0.0.1
# MYSQL_TEST_PORT=3306
# MYSQL_TEST_USER=storefront_migrator
# MYSQL_TEST_PASSWORD=
# MYSQL_TEST_DATABASE=storefront_it_test
# MYSQL_REQUIRE=1
