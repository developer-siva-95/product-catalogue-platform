{
  "name": "catalogue-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Catalogue REST API (Express, MySQL + MongoDB behind a Repository Pattern)",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:mongodb": "node scripts/with-env.mjs DATABASE_PROVIDER=mongodb -- node src/server.js",
    "start:mysql": "node scripts/with-env.mjs DATABASE_PROVIDER=mysql -- node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:mongodb": "node scripts/with-env.mjs DATABASE_PROVIDER=mongodb -- node --watch src/server.js",
    "dev:mysql": "node scripts/with-env.mjs DATABASE_PROVIDER=mysql -- node --watch src/server.js",
    "seed": "node src/config/seed.js",
    "seed:mongodb": "node scripts/with-env.mjs DATABASE_PROVIDER=mongodb -- node src/config/seed.js",
    "seed:mysql": "node scripts/with-env.mjs DATABASE_PROVIDER=mysql -- node src/config/seed.js",
    "db:migrate:mysql": "node src/db/mysql/migrate.js up",
    "db:migrate:mysql:dry-run": "node src/db/mysql/migrate.js up --dry-run",
    "db:status:mysql": "node src/db/mysql/migrate.js status",
    "db:down:mysql": "node src/db/mysql/migrate.js down",
    "migrate:data": "node src/db/migrate/mongo-to-mysql/cli.js --dry-run",
    "migrate:data:apply": "node src/db/migrate/mongo-to-mysql/cli.js --apply",
    "migrate:data:verify": "node src/db/migrate/mongo-to-mysql/cli.js --verify",
    "migrate:data:rollback": "node src/db/migrate/mongo-to-mysql/cli.js --rollback",
    "test": "node scripts/with-env.mjs DATABASE_PROVIDER=mongodb -- vitest run",
    "test:watch": "vitest",
    "test:coverage": "node scripts/with-env.mjs DATABASE_PROVIDER=mongodb -- vitest run --coverage",
    "test:mysql": "node scripts/with-env.mjs SKIP_MONGO_MEMORY=1 MYSQL_REQUIRE=1 DATABASE_PROVIDER=mysql -- vitest run tests/integration/mysql-foundation.test.js tests/integration/repositories.mysql.test.js tests/integration/contracts.mysql.test.js tests/integration/db-capabilities.mysql.test.js tests/integration/concurrency.mysql.test.js tests/integration/seed.mysql.test.js tests/integration/ops.mysql.test.js",
    "test:contracts": "vitest run tests/integration/contracts.mongo.test.js tests/integration/contracts.mysql.test.js tests/integration/db-capabilities.test.js tests/integration/db-capabilities.mysql.test.js",
    "test:migration": "node scripts/with-env.mjs MYSQL_REQUIRE=1 -- vitest run tests/integration/migration.test.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "vitest": "^5.1.0"
  }
}
